"actions":[]}],"parameters":[{"description":"Object","name":"Object","supplementaryInformation":"Sprite","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"MultiplayerArrowShooter::PlayerBehavior","type":"behavior"}],"objectGroups":[]},{"description":"Check if isAlive.","fullName":"IsAlive","functionType":"Condition","group":"Player Behavior configuration","name":"IsAlive","sentence":"_PARAM0_ isAlive","events":[{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"BooleanVariable"},"parameters":["IsAlive","True",""]}],"actions":[{"type":{"value":"SetReturnBoolean"},"parameters":["True"]}]}],"parameters":[{"description":"Object","name":"Object","supplementaryInformation":"Sprite","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"MultiplayerArrowShooter::PlayerBehavior","type":"behavior"}],"objectGroups":[]},{"description":"Change if isAlive.","fullName":"IsAlive","functionType":"Action","group":"Player Behavior configuration","name":"SetIsAlive","sentence":"_PARAM0_ isAlive: _PARAM2_","events":[{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"BooleanVariable"},"parameters":["Value","False",""]}],"actions":[{"type":{"value":"SetBooleanVariable"},"parameters":["IsAlive","False",""]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"BooleanVariable"},"parameters":["Value","True",""]}],"actions":[{"type":{"value":"SetBooleanVariable"},"parameters":["IsAlive","True",""]}]}],"parameters":[{"description":"Object","name":"Object","supplementaryInformation":"Sprite","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"MultiplayerArrowShooter::PlayerBehavior","type":"behavior"},{"defaultValue":"yes","description":"IsAlive","name":"Value","optional":true,"type":"yesorno"}],"objectGroups":[]},{"description":"the aimingAngle of the object.","fullName":"AimingAngle","functionType":"ExpressionAndCondition","group":"Player Behavior configuration","name":"AimingAngle","sentence":"the aimingAngle","events":[{"type":"BuiltinCommonInstructions::Standard","conditions":[],"actions":[{"type":{"value":"SetReturnNumber"},"parameters":["AimingAngle"]}]}],"expressionType":{"type":"expression"},"parameters":[{"description":"Object","name":"Object","supplementaryInformation":"Sprite","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"MultiplayerArrowShooter::PlayerBehavior","type":"behavior"}],"objectGroups":[]},{"fullName":"","functionType":"ActionWithOperator","getterName":"AimingAngle","name":"SetAimingAngle","sentence":"","events":[{"type":"BuiltinCommonInstructions::Standard","conditions":[],"actions":[{"type":{"value":"SetNumberVariable"},"parameters":["AimingAngle","=","Value"]}]}],"parameters":[{"description":"Object","name":"Object","supplementaryInformation":"Sprite","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"MultiplayerArrowShooter::PlayerBehavior","type":"behavior"}],"objectGroups":[]},{"description":"the remainingArrows of the object.","fullName":"RemainingArrows","functionType":"ExpressionAndCondition","group":"Player Behavior configuration","name":"RemainingArrows","sentence":"the remainingArrows","events":[{"type":"BuiltinCommonInstructions::Standard","conditions":[],"actions":[{"type":{"value":"SetReturnNumber"},"parameters":["RemainingArrows"]}]}],"expressionType":{"type":"expression"},"parameters":[{"description":"Object","name":"Object","supplementaryInformation":"Sprite","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"MultiplayerArrowShooter::PlayerBehavior","type":"behavior"}],"objectGroups":[]},{"fullName":"","functionType":"ActionWithOperator","getterName":"RemainingArrows","name":"SetRemainingArrows","sentence":"","events":[{"type":"BuiltinCommonInstructions::Standard","conditions":[],"actions":[{"type":{"value":"Se